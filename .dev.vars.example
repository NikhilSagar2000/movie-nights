USERS={"a":"your-long-passphrase","b":"their-long-passphrase"}
SESSION_SECRET=any-long-random-string
# Optional relay (TURN) for networks that block direct connections. Either or both:
# the fixed username/password for TURN_SERVER in wrangler.jsonc (e.g. ExpressTURN's free plan)
# TURN_USERNAME=...
# TURN_PASSWORD=...
# or a Metered/Open Relay credentials URL (includes apiKey)
# TURN_URL=https://<app>.metered.live/api/v1/turn/credentials?apiKey=...
# Optional: song search for "a song a day" (a free YouTube Data API v3 key). Without it, search says it isn't set up.
# YOUTUBE_API_KEY=...
