{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "movie-nights",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-25",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/ws"]
	},
	"durable_objects": {
		"bindings": [{ "name": "ROOM", "class_name": "Room" }]
	},
	// Free plan only allows SQLite-backed Durable Objects.
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
	"observability": { "enabled": true },
	// The relay's address (not secret). Its username and password are secrets: TURN_USERNAME, TURN_PASSWORD.
	"vars": { "TURN_SERVER": "free.expressturn.com:3478" }
}
